[
  {
    "name": "Social group renders its rail in the header and marks the current view",
    "actions": [
      { "type": "goto", "value": "http://localhost:5199/login" },
      { "type": "evaluate", "value": "localStorage.setItem('kernel_auth_token','22eaf5ad9d78032bfbf8ece522a1431755acc6df806444d322c565a57350f13f'); localStorage.setItem('kernl.setupComplete','1'); localStorage.setItem('kernl.welcomeSeen','1'); 'ok'" },
      { "type": "goto", "value": "http://localhost:5199/people" },
      { "type": "wait", "selector": ".header .tabrail-tab", "timeout": 40000 },
      { "type": "wait", "value": "1500" },
      { "comment": "The rail must be inside the header, and the old bar must be gone from the content area. Also assert the page never scrolls sideways because of it.", "type": "evaluate", "value": "const t=document.querySelector('.tabrail-track'), r=document.querySelector('.tabrail'); JSON.stringify({railInHeader: !!document.querySelector('header.header .tabrail-track'), oldBarInMain: !!document.querySelector('.main-content .sub-tabs:not(.sub-tabs-children)'), group: document.querySelector('.header-nav-group')?.textContent?.trim(), tabs: [...document.querySelectorAll('.tabrail-tab')].map(b=>b.textContent.trim()), current: document.querySelector('.tabrail-tab[aria-current=\"page\"]')?.textContent?.trim(), fadesMatchOverflow: (t.scrollWidth > t.clientWidth+1) === (r.classList.contains('fade-l')||r.classList.contains('fade-r')), bodyScrollX: document.body.scrollWidth > window.innerWidth})" },
      { "type": "screenshot", "value": "tabrail-social" }
    ]
  },
