{
  "$module": "verify-core-views",
  "description": "Navigate through core dashboard views (home, tasks, people, reminders) and verify each renders",
  "params": {},
  "actions": [
    { "$use": "goto-view", "params": { "path": "/home" } },
    { "type": "assert_visible", "selector": ".nav-item" },
    { "$use": "goto-view", "params": { "path": "/tasks" } },
    { "type": "assert_visible", "selector": ".nav-item" },
    { "$use": "goto-view", "params": { "path": "/people" } },
    { "type": "assert_visible", "selector": ".nav-item" },
    { "$use": "goto-view", "params": { "path": "/reminders" } },
    { "type": "assert_visible", "selector": ".nav-item" }
  ]
}
