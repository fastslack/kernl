# systemd user unit — runs as the logged-in user, not root.
# Enable with:    systemctl --user enable --now kernl
# Status:         systemctl --user status kernl
# Logs:           journalctl --user -u kernl -f

[Unit]
Description=Kernl — personal life-management MCP server
Documentation=https://github.com/fastslack/kernl
# Wait for the network so external LLM/HTTP integrations don't fail
# during early-boot if the user enables the service to start at login.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/kernl
Restart=on-failure
RestartSec=3s

# Environment overrides — users override per-account via
# `~/.config/kernl/.env` which the wrapper script sources. Anything
# set here is a hard override (lower precedence is harder to reason about
# than higher).
Environment=NODE_ENV=production

# Resource caps — generous enough for embeddings + transformers but bounded
# so a runaway agent loop can't OOM the desktop. Override per-user via:
#   systemctl --user edit kernl
MemoryHigh=2G
MemoryMax=3G
TasksMax=2048

[Install]
WantedBy=default.target
