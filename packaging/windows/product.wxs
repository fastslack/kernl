<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 3.x descriptor for the Kernl MSI installer.

  Layout written to disk:
    C:\Program Files\Kernl\           (or %INSTALLDIR%, user-overridable)
      bun.exe, mcp-server.js, …
    Start Menu\Programs\Kernl\Kernl.lnk → start.bat

  Manufacturer stays "Matware" — that is the company, and it is what shows
  in the publisher field. Everything the user reads as the product's name is
  "Kernl": someone installs Kernl from lifekernl.com, so Add/Remove Programs
  and the Start Menu must not say something else.

  Per-user data lives at %LOCALAPPDATA%\Kernl (see start.bat) and is created
  on first launch by the wrapper, NOT by the installer — so uninstall doesn't
  destroy the user's tasks/contacts/notes.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Kernl"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Matware"
           UpgradeCode="A8C5F2E1-7B9D-4F8A-B0E6-3D4F5A6B7C8D">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Personal life-management MCP server"
             Manufacturer="Matware" />

    <!-- AllowSameVersionUpgrades: build-msi.sh drops a prerelease suffix from
         ProductVersion, so 0.4.0-rc.1 and 0.4.0 carry the same version. Without
         this, installing the final build over the rc added a second entry to
         Add/Remove Programs instead of upgrading. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Kernl is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Application icon. Without this the Start Menu shortcut and the
         Add/Remove Programs entry both fall back to Windows' generic box.
         ARPPRODUCTICON is what Add/Remove reads; the Shortcut below points at
         the same Icon id. -->
    <Icon Id="KernlIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="KernlIcon" />

    <!-- Top-level features: just one, ships everything. -->
    <Feature Id="ProductFeature" Title="Kernl" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="InstallMarker" />
    </Feature>

    <!-- The in-app updater's way of knowing an MSI owns this folder. It used to
         read only the HKCU value below, which exists for the account that ran
         the installer and nobody else: every other user on the machine was
         treated as an unzipped copy and the update tried to move Program Files.
         HKLM, with the directory, answers for everyone and for a custom
         INSTALLDIR. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="InstallMarker" Guid="{FDFAFD13-0C0C-4C99-B7D2-7B7A469B6586}" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Matware\Kernl">
          <RegistryValue Name="installed" Type="integer" Value="1" KeyPath="yes"/>
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]"/>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!-- Directory tree the installer materializes. -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Kernl" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Kernl" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="Kernl"
                  Description="Personal life-management MCP server"
                  Target="[INSTALLDIR]start.bat"
                  WorkingDirectory="INSTALLDIR"
                  Icon="KernlIcon" />
        <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\Matware\Kernl"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- The big file list. heat.exe regenerates harvested.wxs on every
         build by scanning the staged payload tree, so we don't have to
         maintain it by hand. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Product>
</Wix>
