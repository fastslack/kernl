# Kernl Configuration
#
# ${VAR} interpolation works in this file: both Bun (which runs the kernel)
# and Docker Compose v2 expand ${HOME}, ${PWD} and variables defined earlier
# in this same file. Paths below auto-derive from where the repo lives —
# in most setups you only need to fill in secrets and API keys.
# Caveat: ${PWD} is the directory you *invoke* `docker compose` / `bun` from,
# so run them from the repo root (install.sh and the npm scripts already do).

# ============================================
# Security
# ============================================

# API authentication token — MANDATORY in production. All /api/* require Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
# Bootstrap will refuse to start if this is empty unless KERNEL_ALLOW_UNAUTH=1 is exported.
KERNEL_AUTH_TOKEN=REPLACE_WITH_openssl_rand_-hex_32

# Encryption key for stored secrets (channel keys, OAuth tokens, etc.). Required in production.
# Generate with: openssl rand -hex 32
KERNEL_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-hex_32

# Comma-separated list of allowed CORS origins. Leave EMPTY unless you actually
# serve the dashboard from a different origin than the API: empty means the API
# sends no Access-Control-Allow-Origin at all, so only same-origin callers (the
# bundled dashboard) can read it. List an origin here only for a setup that
# needs it — e.g. a SvelteKit dev server on http://localhost:5173.
CORS_ALLOWED_ORIGINS=

# Comma-separated list of modules to disable (skip during initialization)
# Example: DISABLED_MODULES=cameras,wearables,federation,twitter
DISABLED_MODULES=

# ============================================
# Database
# ============================================

# SQLite database path
SQLITE_PATH=./data/kernel.db

# Neo4j (optional - for graph features)
# CHANGE NEO4J_PASSWORD before any deployment. Bolt is bound to 127.0.0.1 in docker-compose,
# but a weak password is still trivially brute-forced if the loopback bind is ever loosened.
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_openssl_rand_-hex_32

# ============================================
# Core Settings
# ============================================

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Timezone for display (storage is always UTC). Set to your local IANA zone.
TIMEZONE=UTC

# MCP transport mode: stdio | http | both
MCP_TRANSPORT=both

# ============================================
# mtwRequest Bridge
# ============================================

# Enable Unix socket bridge for mtwRequest (Rust transport layer)
BRIDGE_ENABLED=false
# Socket path (mtwRequest connects here for tool calls)
BRIDGE_SOCKET_PATH=/tmp/kernl.sock
# mtwRequest WebSocket URL (auto-set in Docker via docker-compose.full.yml)
KERNEL_URL=ws://localhost:7741/ws

# Rust Bridge (delegate heavy compute to mtwRequest Rust runtime)
RUST_BRIDGE_ENABLED=false
RUST_BRIDGE_SOCKET=/tmp/mtw-rust.sock

# ============================================
# Dashboard
# ============================================

DASHBOARD_ENABLED=true
DASHBOARD_PORT=3086
DASHBOARD_REFRESH_MS=30000

# ============================================
# Telegram Bot
# ============================================

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed Telegram user IDs
TELEGRAM_ALLOWED_USERS=
# Default chat ID for proactive notifications
TELEGRAM_DEFAULT_CHAT=

# ============================================
# Multi-Channel Support
# ============================================

# WhatsApp (via Baileys)
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_PATH=./data/whatsapp-auth
# Comma-separated phone numbers allowed to use the bot
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_DEFAULT_CHAT=

# Slack (via Bolt)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated user/channel IDs
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=
SLACK_DEFAULT_CHANNEL=

# Discord (via discord.js)
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Comma-separated user/guild/channel IDs
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_GUILDS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_DEFAULT_CHANNEL=

# WebChat (WebSocket)
WEBCHAT_ENABLED=false
WEBCHAT_REQUIRE_AUTH=true
WEBCHAT_API_KEY=

# ============================================
# Voice (STT/TTS)
# ============================================

VOICE_ENABLED=false
# STT provider: openai | local-whisper
VOICE_STT_PROVIDER=openai
# TTS provider: elevenlabs | openai | system
VOICE_TTS_PROVIDER=system
# Voice ID for TTS (e.g., "alloy" for OpenAI)
VOICE_DEFAULT_ID=alloy
# Respond to voice messages with voice
VOICE_RESPOND_WITH_VOICE=false
# Path to local whisper.cpp binary (if using local-whisper)
LOCAL_WHISPER_PATH=

# ============================================
# API Keys
# ============================================

# OpenAI (for voice STT/TTS, chat, web-intel)
OPENAI_API_KEY=

# Anthropic (for chat, web-intel)
ANTHROPIC_API_KEY=

# xAI Grok (OpenAI-compatible endpoint). GROK_API_KEY preferred; XAI_API_KEY accepted as alias.
# GROK_DEFAULT_MODEL optional — override the factory default (grok-2-1212).
GROK_API_KEY=
GROK_DEFAULT_MODEL=

# NVIDIA NIM (OpenAI-compatible endpoint at integrate.api.nvidia.com).
# Hosts DeepSeek, Llama, Mistral, etc. NVIDIA_DEFAULT_MODEL optional — override
# the factory default (deepseek-ai/deepseek-v4-pro).
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=

# ElevenLabs (for TTS)
ELEVENLABS_API_KEY=

# ============================================
# Notifications
# ============================================

# Mattermost webhook
MATTERMOST_WEBHOOK_URL=
MATTERMOST_CHANNEL_ID=
MATTERMOST_USERNAME=Kernl
MATTERMOST_ICON_URL=

# ============================================
# Reminders & Proactive Engine
# ============================================

REMINDER_POLL_INTERVAL_MS=30000

PROACTIVE_ENABLED=true
PROACTIVE_MORNING_TIME=07:00
PROACTIVE_EVENING_TIME=21:00

# ============================================
# Life Intelligence
# ============================================

# Location for weather, sun times, etc. Defaults below are Greenwich (UK) —
# set to your actual coordinates.
LIFE_LAT=51.4769
LIFE_LON=0.0005
LIFE_CITY=Greenwich

# Currency conversions (comma-separated)
LIFE_CURRENCIES=USD,EUR,GBP

# World clocks (comma-separated timezone IDs)
LIFE_CLOCKS=America/New_York,Europe/London,Asia/Tokyo

# Daily water goal (glasses)
LIFE_WATER_GOAL=8

# ============================================
# Google Sync (OAuth2)
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_PORT=8787

# ============================================
# Chat & Agents
# ============================================

# Default LLM provider: claude | openai | lmstudio
CHAT_DEFAULT_PROVIDER=claude
CHAT_DEFAULT_MODEL=
CHAT_EXTRACTION_MODEL=
CHAT_CONTEXT_BUDGET=2000
CHAT_MAX_EPISODE_MESSAGES=100
CHAT_DECAY_INTERVAL_MS=3600000
CHAT_PATTERN_INTERVAL_MS=86400000
CHAT_SYSTEM_PROMPT=

AGENTS_POLL_INTERVAL_MS=30000
AGENTS_MAX_CONCURRENT=3
AGENTS_DEFAULT_PROVIDER=
AGENTS_DEFAULT_MODEL=

# ============================================
# Web Intelligence
# ============================================

WEBINTEL_POLL_INTERVAL_MS=60000
WEBINTEL_DEFAULT_LLM=claude

# Search providers (at least one recommended)
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARXNG_BASE_URL=

# Local LLM
LMSTUDIO_BASE_URL=

# ============================================
# Email (Resend)
# ============================================

RESEND_API_KEY=

# ============================================
# Issues Sync
# ============================================

ISSUES_SYNC_INTERVAL_MS=900000

# ============================================
# Docker Compose
# ============================================

# -- mtwRequest --
KERNEL_PORT=7741
RUST_LOG=info,mtw=debug
KERNEL_HOST=0.0.0.0

# (Rust Bridge inside Docker is hardcoded to enabled in docker-compose.full.yml —
#  the local default lives in the "mtwRequest Bridge" section above. Do NOT
#  redefine RUST_BRIDGE_* here: duplicated keys silently override the local
#  value, Bun keeps the LAST occurrence.)

# -- Kernel (Docker overrides) --
DOCKER_MCP_TRANSPORT=http
DOCKER_DASHBOARD_ENABLED=false
DOCKER_DASHBOARD_PORT=3087
DOCKER_SQLITE_PATH=/app/data/kernel.db
DOCKER_NEO4J_URI=bolt://neo4j:7687
DOCKER_WHATSAPP_AUTH_PATH=/app/data/whatsapp-auth
DOCKER_KERNEL_URL=ws://mtw-request:7741/ws
DOCKER_IBKR_GATEWAY_URL=https://ibkr-gateway:5000
# Public URL the dashboard is reachable at (links in notifications, OAuth callbacks)
DASHBOARD_PUBLIC_URL=http://localhost:3086
# Live trading kill-switch (Pro trading extension; keep false unless you know what you're doing)
TRADING_LIVE_ENABLED=false

# -- Neo4j --
# Auto-derived from NEO4J_USER / NEO4J_PASSWORD set in the Database section —
# one password, defined once.
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASSWORD}
NEO4J_PLUGINS=["graph-data-science"]
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m
NEO4J_GDS_PROCEDURES=gds.*

# -- IBKR Gateway --
IBEAM_ACCOUNT=
IBEAM_PASSWORD=
IBEAM_GATEWAY_BASE_URL=https://localhost:5000
IBEAM_LOG_LEVEL=INFO
IBEAM_TRADING_MODE=paper
IBEAM_REQUEST_RETRIES=10
IBEAM_PAGE_LOAD_TIMEOUT=60
IBKR_ACCOUNT_ID=
IBKR_ENABLED=false

# ============================================
# Docker Compose: host paths
# ============================================
# Only needed for the FULL stack (`docker compose -f docker-compose.full.yml up`;
# the default docker-compose.yml needs none of these). They tell the
# kernel container where to find files on the host so bind-mounts and
# Docker-in-Docker path translation work correctly.

# Your Unix home directory on the host. Mounted read-only inside the kernel
# container so the Claude Agent SDK can read OAuth tokens from ~/.claude.
# Auto-derived; only override for exotic setups.
HOST_HOME=${HOME}

# Absolute host path to this kernel checkout (what you `git clone`d). The
# claude_code executor rewrites /app/… paths back to this root when it
# spawns sandboxed sub-runs via Docker-in-Docker.
# Auto-derived from where you run `docker compose` (the repo root).
HOST_KERNEL_ROOT=${PWD}

# Absolute host path to the parent directory of all your working projects.
# Mounted read-only at /host-projects inside the kernel container so
# workspaces can read source from sibling repos.
# Defaults to the checkout's parent dir; point it elsewhere if your projects
# live somewhere else.
HOST_PROJECTS_ROOT=${PWD}/..

# Optional overrides — default to sensible locations under HOST_HOME when
# unset. Set explicitly if your Claude CLI / credentials live elsewhere.
#HOST_CLAUDE_CLI=${HOME}/.local/bin/claude
#HOST_CLAUDE_JSON=${HOME}/.claude.json
#HOST_CLAUDE_CREDS=${HOME}/.claude/.credentials.json

# ============================================
# Docker Compose: mtwRequest / bridge source
# ============================================
# Both images are built from local source. Point these at your clone of
# the mtwRequest sibling repo. If you'd rather consume pre-built images
# from a registry, change the `image:` lines in docker-compose.full.yml and
# drop these.
# Defaults assume mtwRequest is cloned next to this repo; adjust if not.
KERNEL_REQUEST_SRC=${PWD}/../mtwRequest
KERNEL_WHATSAPP_BRIDGE_SRC=${KERNEL_REQUEST_SRC}/services/whatsapp-bridge

# Prefix for the locally-built Docker images. Safe to leave as `localhost`
# for dev; change to your Docker Hub / GHCR namespace for shared deploys.
KERNEL_IMAGE_NAMESPACE=localhost

# ── MCP Bridge (external MCP servers) ─────────────────────────────────────
# JSON array of MCP servers to connect to at startup.
# Each tool is exposed as mcp_{name}_{tool_name} in chat and agents.
#
# stdio example (spawn a local process):
#   MCP_BRIDGE_SERVERS='[{"name":"filesystem","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/home/user"]}]'
#
# http example (connect to a remote server):
#   MCP_BRIDGE_SERVERS='[{"name":"myapi","type":"http","url":"http://localhost:9000/mcp","token":"secret"}]'
#
# Optional per-server filters:
#   "allowTools": ["read_file","write_file"]   — whitelist
#   "denyTools":  ["delete_file"]              — blacklist
MCP_BRIDGE_SERVERS=
