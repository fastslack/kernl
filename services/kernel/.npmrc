# The runtime is Bun (bun.lock is the source of truth). npm is used only by
# the release workflow's packaging pipeline, which needs native prebuilds.
#
# @anthropic-ai/claude-agent-sdk declares a peer dependency on zod@^4, but the
# rest of the stack (MCP SDK, @anthropic-ai/sdk, this project) is on zod@3.25.x.
# Bun installs zod 3.25.76 (which everything except that one peer hint accepts)
# and runs fine. npm's strict peer resolver refuses without this flag, which
# would break `npm ci` / `npm install` in release.yml.
legacy-peer-deps=true
