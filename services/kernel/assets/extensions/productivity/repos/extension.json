    "repos",
    "git",
    "filesystem",
    "office"
  ],
  "kernel_min": "0.1.0",
  "permissions": [
    "module:repos",
    "filesystem",
    "network"
  ],
  "backend": {
    "entry": "backend/entry.js",
    "packages": {
      "uuid": "11.1.1",
      "zod": "3.25.76"
    }
  },
