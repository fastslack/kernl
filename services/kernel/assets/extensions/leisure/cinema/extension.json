{
  "$schema": "kernl://extension/v1",
  "id": "com.kernl.cinema",
  "slug": "cinema",
  "name": "Cinema",
  "version": "1.28.0",
  "type": "module",
  "description": "archive.org movie catalog with semantic search and Nostr discovery.",
  "author": "Kernl",
  "license": "Apache-2.0",
  "category": "leisure",
  "tags": [
    "cinema",
    "movies",
    "archive"
  ],
  "kernel_min": "0.1.0",
  "permissions": [
    "network",
    "module:cinema"
  ],
  "backend": {
    "entry": "backend/entry.js",
    "packages": {
      "@anthropic-ai/claude-agent-sdk": "0.2.114",
      "@modelcontextprotocol/sdk": "1.26.0",
      "uuid": "11.1.0",
      "zod": "3.25.76"
    }
  },
  "frontend": {
    "pages": [
      {
        "view": "cinema",
        "entry": "frontend/entry.js",
        "title": "Cinema"
      }
    ]
  }
