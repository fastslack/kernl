{
  "$schema": "kernl://extension/v1",
  "id": "com.kernl.events",
  "slug": "events",
  "name": "Events",
  "version": "1.1.0",
  "type": "module",
  "description": "Event registry — invitations, RSVPs, confirmation thresholds, recurrence.",
  "author": "Kernl",
  "license": "Apache-2.0",
  "category": "people",
  "tags": [
    "events",
    "rsvp",
    "invitations"
  ],
  "kernel_min": "0.1.0",
  "permissions": [
    "read:events",
    "write:events",
    "notifications"
  ],
  "backend": {
    "entry": "backend/entry.js",
    "packages": {
      "cron-parser": "5.5.0",
      "uuid": "11.1.0",
      "zod": "3.25.76"
    }
  },
  "frontend": {
    "pages": [
      {
        "view": "planner",
        "entry": "frontend/entry.js",
        "title": "Planner"
      }
    ]
  }
}
