{
  "$schema": "kernl://extension/v1",
  "id": "com.kernl.shopping",
  "slug": "shopping",
  "name": "Shopping",
  "version": "1.1.0",
  "type": "module",
  "description": "Shopping lists, products catalog, low-stock alerts.",
  "author": "Kernl",
  "license": "Apache-2.0",
