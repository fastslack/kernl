    "shopping",
    "lists",
    "core"
  ],
  "kernel_min": "0.1.0",
  "permissions": [
    "module:shopping"
  ],
  "backend": {
    "entry": "backend/entry.js",
    "packages": {
      "@anthropic-ai/claude-agent-sdk": "0.2.114",
      "@modelcontextprotocol/sdk": "1.26.0",
      "uuid": "11.1.0",
      "zod": "3.25.76"
    }
  },
  "frontend": {
    "pages": [
      {
        "view": "shopping",
