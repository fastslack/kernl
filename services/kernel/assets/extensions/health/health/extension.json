{
  "$schema": "kernl://extension/v1",
  "id": "com.kernl.health",
  "slug": "health",
  "name": "Health",
  "version": "1.1.1",
  "type": "module",
  "description": "Health metrics, medications, appointments.",
  "author": "Kernl",
  "license": "Apache-2.0",
