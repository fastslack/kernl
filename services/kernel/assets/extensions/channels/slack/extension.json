    "notifications",
    "messaging"
  ],
  "kernel_min": "0.1.0",
  "permissions": [
    "network"
  ],
  "backend": {
    "entry": "backend/entry.js",
    "packages": {
      "@slack/bolt": "4.7.3"
    }
  }
}
