{
  "name": "kernl",
  "private": true,
  "version": "0.3.0",
  "description": "Personal Life Management MCP Server",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Matias Aguirre",
    "email": "fastslack@gmail.com",
    "url": "https://github.com/fastslack"
  },
  "contributors": [
    {
      "name": "Matware",
      "url": "https://github.com/fastslack/kernl"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fastslack/kernl.git"
  },
  "homepage": "https://github.com/fastslack/kernl#readme",
  "bugs": "https://github.com/fastslack/kernl/issues",
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run bin/mcp-server.ts",
    "dev": "bun run bin/mcp-server.ts",
    "dev:watch": "bun --watch run bin/mcp-server.ts",
    "build": "bun build bin/mcp-server.ts --outdir dist --target bun --external onnxruntime-node --external @huggingface/transformers --external better-sqlite3 && cp -r src/modules/dashboard/static dist/ && bun run build:extensions",
    "build:extensions": "bun run scripts/build-extensions.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "tsc --noEmit",
    "lint:i18n": "bun scripts/lint-i18n.ts",
    "test:i18n": "bun scripts/demo-i18n.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "wizard": "bun run src/cli/wizard.ts",
    "cli": "bun scripts/cli/run.ts",
    "cli:today": "bun scripts/cli/run.ts today",
    "cli:health": "bun scripts/cli/run.ts db-health",
    "cli:dedup": "bun scripts/cli/run.ts contacts-dedup",
    "cli:maint": "bun scripts/cli/run.ts maintenance-due",
    "cli:cleanup": "bun scripts/cli/run.ts cleanup",
    "cli:export": "bun scripts/cli/run.ts export-summary"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@aws-sdk/client-s3": "^3.723.0",
    "@aws-sdk/lib-storage": "^3.723.0",
    "@huggingface/transformers": "^3.8.1",
    "@matware/mtw-request-ts-client": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@msgpack/msgpack": "^3.1.3",
    "@slack/bolt": "^4.6.0",
    "@types/sanitize-html": "^2.16.1",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "elevenlabs": "^1.59.0",
    "file-type": "^19.6.0",
    "grammy": "^1.41.1",
    "imapflow": "^1.3.2",
    "jimp": "^1.6.0",
    "link-preview-js": "^4.0.0",
    "neo4j-driver": "^5.28.1",
    "nodemailer": "^8.0.5",
    "nostr-tools": "^2.23.3",
    "openai": "^6.25.0",
    "sanitize-html": "^2.17.3",
    "ssh2-sftp-client": "^11.0.0",
    "tar-stream": "^3.1.7",
    "uuid": "^11.1.0",
    "webdav": "^5.7.0",
    "ws": "^8.19.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/tar-stream": "^3.1.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "bun-types": "^1.3.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
