# ── Dashboard (public eval stack): self-contained SPA build + nginx ──
#
# Unlike ./Dockerfile (which is nginx-only and serves a HOST-mounted
# `./dashboard/build/`), this image BUILDS the SvelteKit SPA inside the image
# and bakes the result in. That way a fresh `git clone` needs no host-side
# build step — `docker compose up --build` just
# works. Used only by the public eval stack.

FROM oven/bun:1.2 AS build
WORKDIR /src
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY . .
# The dashboard imports its shared widgets from the extensions' frontend
# library ($shared → ../kernel/assets/extensions/_shared). It lives outside
# this build context, so compose passes it as the `shared` context.
COPY --from=shared . /kernel/assets/extensions/_shared
RUN bun run build

FROM nginx:alpine
COPY --from=build /src/build /usr/share/nginx/html
COPY nginx.public.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
